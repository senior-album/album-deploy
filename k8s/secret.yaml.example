apiVersion: v1
kind: Secret
metadata:
  name: backend-secret
  namespace: senior-album
type: Opaque
stringData:
  # ⚠️ 배포 전에 반드시 실제 값으로 변경하세요\!
  JWT_SECRET: "CHANGE-ME-to-a-random-64-char-string"

  # MinIO
  MINIO_ACCESS_KEY: "CHANGE-ME"
  MINIO_SECRET_KEY: "CHANGE-ME"

  # PostgreSQL
  POSTGRES_PASSWORD: "CHANGE-ME"

  # 카카오 OAuth (선택)
  KAKAO_CLIENT_ID: ""
  KAKAO_CLIENT_SECRET: ""

  # CoolSMS (SMS_PROVIDER=coolsms 일 때만 필요 — 기본값 log 은 불필요)
  # 발신번호는 CoolSMS 콘솔에서 사전등록 완료된 번호만 사용 가능
  # 자세한 절차: album-backend/docs/COOLSMS_SETUP.md
  COOLSMS_API_KEY: ""
  COOLSMS_API_SECRET: ""
  COOLSMS_FROM_NUMBER: ""
