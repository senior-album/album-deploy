apiVersion: v1
kind: Secret
metadata:
  name: backend-secret
  namespace: senior-album
type: Opaque
stringData:
  # ⚠️ 배포 전에 반드시 실제 값으로 변경하세요\!
  JWT_SECRET: "CHANGE-ME-to-a-random-64-char-string"

  # MinIO
  MINIO_ACCESS_KEY: "CHANGE-ME"
  MINIO_SECRET_KEY: "CHANGE-ME"

  # PostgreSQL
  POSTGRES_PASSWORD: "CHANGE-ME"

  # 카카오 OAuth (선택)
  KAKAO_CLIENT_ID: ""
  KAKAO_CLIENT_SECRET: ""
