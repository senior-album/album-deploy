# T-044: minio-backup CronJob 이 R2 업로드에 쓰는 크레덴셜.
#
# 실제 배포에선 이 파일을 평문으로 커밋하지 말고 SealedSecret 으로 변환:
#
#   kubeseal --format yaml \
#     --controller-namespace sealed-secrets \
#     --controller-name sealed-secrets-controller \
#     < k8s/backup-secret.yaml \
#     > k8s/sealed/backup-secret.yaml
#
# 그 후 `k8s/backup-secret.yaml` 은 삭제, `k8s/sealed/backup-secret.yaml` 만
# 커밋. (backend-secret 과 동일 절차)
#
# R2 접근 키는 Cloudflare 대시보드 → R2 → Manage API Tokens 에서 생성.
# 백업 전용 토큰은 "Object Read & Write" 를, 가능하면 이 버킷 prefix 로 scope 제한.
apiVersion: v1
kind: Secret
metadata:
  name: backup-secret
  namespace: senior-album
type: Opaque
stringData:
  # <ACCOUNT_ID>.r2.cloudflarestorage.com 형태. https:// 포함.
  R2_ENDPOINT: "https://CHANGE-ME.r2.cloudflarestorage.com"
  R2_ACCESS_KEY: "CHANGE-ME"
  R2_SECRET_KEY: "CHANGE-ME"
  # R2 측 대상 버킷 이름 — 사전에 생성 권장 (CronJob 도 --ignore-existing 으로 시도는 함).
  R2_BUCKET: "senior-album-photos-backup"
