---
# T-042: Grafana admin 비밀번호.
#
# 첫 로그인용. 회전 시 grafana SealedSecret 갱신 + grafana pod 재시작.
# 실제 클러스터에는 `k8s/sealed/grafana-secret.yaml` (SealedSecret) 가 있어야 함.
apiVersion: v1
kind: Secret
metadata:
  name: grafana-secret
  namespace: senior-album
type: Opaque
stringData:
  ADMIN_PASSWORD: "CHANGE-ME-strong-random-string"
