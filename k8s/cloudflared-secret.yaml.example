# Cloudflare Tunnel 토큰을 담는 Secret 템플릿.
#
# 실제 배포에선 이 파일을 평문으로 커밋하지 말고 SealedSecret 으로 변환:
#
#   cp k8s/cloudflared-secret.yaml.example k8s/cloudflared-secret.yaml
#   # k8s/cloudflared-secret.yaml 의 TUNNEL_TOKEN 값을 실제 토큰으로 교체
#   kubeseal --format yaml \
#     --controller-namespace sealed-secrets \
#     --controller-name sealed-secrets-controller \
#     < k8s/cloudflared-secret.yaml \
#     > k8s/sealed/cloudflared-secret.yaml
#   # 평문 파일은 삭제, sealed 버전만 커밋
#   rm k8s/cloudflared-secret.yaml
#   git add k8s/sealed/cloudflared-secret.yaml
#
# 토큰 발급: Cloudflare 대시보드 → Zero Trust → Networks → Tunnels → <tunnel> → Install connector → Docker 탭의 token 값.
apiVersion: v1
kind: Secret
metadata:
  name: cloudflared-secret
  namespace: senior-album
type: Opaque
stringData:
  TUNNEL_TOKEN: "CHANGE-ME"
