apiVersion: v1
kind: Secret
metadata:
  name: opensearch-security-secret
  namespace: senior-album
type: Opaque
stringData:
  # ⚠️ 직접 편집하지 말 것 — scripts/bootstrap-opensearch-security.sh 가 생성한다.
  # 이 파일은 형식 안내용이며, 실제 운영 값은 k8s/sealed/opensearch-security-secret.yaml
  # (SealedSecret) 안에 봉인되어 있다.
  #
  # 키 의미:
  #   admin-password    — admin 사용자 평문 비번 (ops 비상용 직접 로그인)
  #   backend-password  — album_backend 서비스 계정 평문 비번
  #                       (T-004c 가 backend-secret.OPENSEARCH_PASSWORD 로 옮길 때 추출)
  #   internal_users.yml — OpenSearch Security 플러그인의 사용자 정의 파일 전체 본문
  #                        admin + album_backend 의 bcrypt 해시 포함
  admin-password: "REPLACE-WITH-RANDOM-40CHAR-URLSAFE"
  backend-password: "REPLACE-WITH-RANDOM-40CHAR-URLSAFE"
  internal_users.yml: |
    ---
    _meta:
      type: "internalusers"
      config_version: 2

    admin:
      hash: "$2b$12$REPLACE_WITH_BCRYPT_HASH_OF_ADMIN_PASSWORD"
      reserved: true
      hidden: false
      backend_roles:
        - "admin"
      attributes: {}
      description: "Album OpenSearch admin (T-004)"

    album_backend:
      hash: "$2b$12$REPLACE_WITH_BCRYPT_HASH_OF_BACKEND_PASSWORD"
      reserved: false
      hidden: false
      backend_roles:
        - "admin"
      attributes: {}
      description: "Album backend service account (T-004)"
