apiVersion: v1
kind: ConfigMap
metadata:
  name: backend-config
  namespace: senior-album
data:
  PROJECT_NAME: "Senior Album API"
  VERSION: "0.2.0"
  DEBUG: "False"

  # 데이터베이스 (k8s 서비스명 기준)
  DATABASE_URL: "postgresql+asyncpg://postgres:postgres@postgres:5432/senior_album"

  # Redis
  REDIS_URL: "redis://redis:6379/0"

  # JWT
  JWT_ALGORITHM: "HS256"
  JWT_EXPIRE_MINUTES: "10080"
  JWT_REFRESH_THRESHOLD_MINUTES: "1440"

  # 얼굴 인식
  FACE_SIMILARITY_THRESHOLD: "0.6"
  FACE_DETECTION_CONFIDENCE: "0.9"

  # OpenSearch
  OPENSEARCH_HOST: "opensearch"
  OPENSEARCH_PORT: "9200"

  # CORS (실제 배포 도메인으로 교체)
  ALLOWED_ORIGINS: '["https://your-domain.com","http://localhost:5173"]'

  # MinIO (k8s 서비스명 기준)
  MINIO_ENDPOINT: "minio:9000"
  MINIO_BUCKET: "senior-album-photos"
  MINIO_USE_SSL: "False"
  MINIO_EXTERNAL_ENDPOINT: "https://storage.your-domain.com"

  # 외부 URL (실제 배포 도메인으로 교체)
  FRONTEND_URL: "https://your-domain.com"
  API_BASE_URL: "https://your-domain.com/api"

  # 공유/보안
  SHARE_LINK_EXPIRE_HOURS: "72"
  LOGIN_MAX_ATTEMPTS: "5"
  LOGIN_LOCKOUT_MINUTES: "15"
  UPLOAD_DIR: "/app/uploads"
  DDL_AUTO: "create"

  # 카카오 OAuth (실제 도메인으로 교체)
  KAKAO_REDIRECT_URI: "https://your-domain.com/auth/kakao/callback"

  # SMS 프로바이더 — log(개발·기본) | coolsms(프로덕션)
  # coolsms 로 전환 시 backend-secret 에 COOLSMS_API_KEY / SECRET / FROM_NUMBER 주입 필요
  # 참고: album-backend/docs/COOLSMS_SETUP.md
  SMS_PROVIDER: "log"
