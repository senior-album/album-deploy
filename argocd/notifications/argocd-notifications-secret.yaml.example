---
# T-129: ArgoCD Notifications 용 Discord webhook URL.
#
# 이 파일은 .example — 실제 클러스터에는 같은 이름의 SealedSecret 또는
# 일반 Secret 을 직접 apply 한다. argocd-notifications-controller 가
# argocd-notifications-cm 의 `$discord-webhook-url` 참조를 이 Secret 의
# `discord-webhook-url` 키 값으로 치환.
#
# webhook URL 정책 (T-129 티켓의 원 의도: T-041 의 같은 웹훅 재사용):
# - T-041 의 senior-album/backend-secret 의 DISCORD_OPS_WEBHOOK_URL 평문 값을
#   그대로 이 Secret 의 discord-webhook-url 에 넣으면 같은 채널로 합쳐짐.
# - 채널을 분리하고 싶으면 Discord 에서 별도 채널/webhook 만들어 그 URL 사용.
#   (트래픽 분리·음소거 정책 분리 가능 — 운영 후 노이즈 보고 결정 권장.)
#
# 적용 (sealed):
#   # 1. 평문 Secret 작성 (이 파일을 복사 + URL 채우기)
#   cp argocd-notifications-secret.yaml.example /tmp/argocd-notifications-secret.yaml
#   # → /tmp/argocd-notifications-secret.yaml 의 discord-webhook-url 값을
#   #    실제 webhook URL 로 변경
#
#   # 2. SealedSecret 으로 봉인 (cluster pub key 필요)
#   kubeseal --controller-namespace=kube-system \
#            --controller-name=sealed-secrets-controller \
#            --format yaml \
#            < /tmp/argocd-notifications-secret.yaml \
#            > argocd/notifications/argocd-notifications-secret.sealed.yaml
#
#   # 3. apply (argocd 네임스페이스 — senior-album Application 의 destination
#   #    밖이라 GitOps 자동 동기화 대상이 아님, 수동 apply 필수)
#   kubectl apply -f argocd/notifications/argocd-notifications-secret.sealed.yaml
#
#   # 4. notifications-cm 도 같은 방식으로 수동 apply
#   kubectl apply -f argocd/notifications/argocd-notifications-cm.yaml
#
#   # 5. controller 재로드 (configmap/secret 변경 감지)
#   kubectl -n argocd rollout restart deploy/argocd-notifications-controller
apiVersion: v1
kind: Secret
metadata:
  name: argocd-notifications-secret
  namespace: argocd
  labels:
    app.kubernetes.io/name: argocd-notifications-secret
    app.kubernetes.io/part-of: argocd
type: Opaque
stringData:
  # Discord 채널 → Edit Channel → Integrations → Webhooks → New Webhook
  # 으로 발급받은 URL. 외부에 노출 금지 — 누구나 메시지 송신 가능.
  discord-webhook-url: "https://discord.com/api/webhooks/CHANGE-ME/CHANGE-ME"
